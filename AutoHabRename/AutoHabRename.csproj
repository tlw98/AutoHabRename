<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>AutoHabRename</AssemblyName>
        <RootNamespace>AutoHabRename</RootNamespace>
        <OutputType>Library</OutputType>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(TERRAINVICTA_PATH)/TerraInvicta_Data/Managed/UnityModManager/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(TERRAINVICTA_PATH)/TerraInvicta_Data/Managed/Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(TERRAINVICTA_PATH)/TerraInvicta_Data/Managed/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(TERRAINVICTA_PATH)/TerraInvicta_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityModManager">
            <HintPath>$(TERRAINVICTA_PATH)/TerraInvicta_Data/Managed/UnityModManager/UnityModManager.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(ProjectDir)ModInfo.json" DestinationFiles="$(TERRAINVICTA_PATH)/Mods/Enabled/$(ProjectName)/ModInfo.json" OverwriteReadOnlyFiles="true" />
        <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFiles="$(TERRAINVICTA_PATH)/Mods/Enabled/$(ProjectName)/$(ProjectName).dll" OverwriteReadOnlyFiles="true" />
        <Copy SourceFiles="$(ProjectDir)module_names.txt" DestinationFiles="$(TERRAINVICTA_PATH)/Mods/Enabled/$(ProjectName)/module_names.txt" OverwriteReadOnlyFiles="true" />
        <Copy SourceFiles="$(ProjectDir)orbit_names.txt" DestinationFiles="$(TERRAINVICTA_PATH)/Mods/Enabled/$(ProjectName)/orbit_names.txt" OverwriteReadOnlyFiles="true" />
    </Target>
</Project>